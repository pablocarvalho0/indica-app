# Dependências
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Build e cache
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.turbo/
.swc/

# Variáveis de ambiente — nunca versionar segredo.
# O que vai para o repo é só o .env.example, com placeholder.
.env
.env.*
!.env.example

# Banco / Drizzle
# As migrações EM SI devem ser versionadas (drizzle/ ou drizzle/migrations/).
# Aqui só ignoramos artefato local e dump.
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Supabase CLI (stack local em Docker)
supabase/.branches/
supabase/.temp/
supabase/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testes e cobertura
coverage/
.nyc_output/
playwright-report/
test-results/
/blob-report/
.playwright/

# Vercel
.vercel

# Sistema operacional
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# Editor
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# .vscode/tasks.json fica de fora de propósito: é GERADO pelo plugin frentes
# (--gerar-tasks) a partir do .claude/frentes.conf, e os rótulos das tasks vêm
# dos checkpoints locais da máquina.

# Ferramentas de IA — configuração local, não compartilhada
.claude/settings.local.json
.gstack/

# Frentes de trabalho — quais checkpoints retomar amanhã. Fica fora do repo
# porque guarda caminho absoluto desta máquina. A ferramenta em si não vive
# aqui: vem do plugin frentes (ver CLAUDE.md), que traz o próprio template.
#
# Padrão sem barra: casa em QUALQUER profundidade. Cobre o .claude/frentes.conf
# de hoje e qualquer cópia que apareça amanhã — fecha a classe, não a instância.
frentes.conf
