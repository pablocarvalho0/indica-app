# ------------------------------------------------------------------
# Indica — variáveis de ambiente
#
# Copie este arquivo para .env e preencha com os seus valores:
#   cp .env.example .env
#
# O .env é ignorado pelo git e NUNCA deve ser commitado.
# Este arquivo (.env.example) vai para o repo e só contém placeholder:
# ao adicionar uma variável nova no .env, adicione aqui também, sem o valor.
# ------------------------------------------------------------------


# --- Banco de dados (Postgres / Supabase) -------------------------
# Onde achar: painel do Supabase > Project Settings > Database > Connection string.
# Em desenvolvimento local com `supabase start`, use a string que o CLI imprime.

# Conexão da aplicação. Em serverless (Vercel), use a porta do pooler (6543).
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true"

# Conexão direta, sem pooler (porta 5432). O Drizzle usa esta para migração:
# `drizzle-kit` roda DDL, e DDL não funciona bem através do pooler em modo transaction.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/postgres"


# --- Supabase (cliente) -------------------------------------------
# Onde achar: painel do Supabase > Project Settings > API.
# Tudo com prefixo NEXT_PUBLIC_ vai para o bundle do navegador e é PÚBLICO.
# Nunca coloque segredo atrás desse prefixo.

NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública de leitura. Projetos mais novos do Supabase exibem essa chave como
# "publishable key" (sb_publishable_...) em vez de "anon key" — confirme o nome no
# painel do seu projeto e ajuste este nome de variável se for o caso.
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole-a-chave-publica-aqui"


# --- Supabase (servidor) ------------------------------------------
# Chave de serviço: ignora Row Level Security. Só em código de servidor,
# nunca importada em componente de cliente. Se vazar, rotacione imediatamente
# no painel do Supabase.
# Sem prefixo NEXT_PUBLIC_ de propósito — é isso que a mantém fora do bundle.
SUPABASE_SERVICE_ROLE_KEY="cole-a-chave-de-servico-aqui"


# --- Aplicação ----------------------------------------------------
# URL base do app. Em desenvolvimento, http://localhost:3000.
# Em produção, a Vercel expõe VERCEL_URL automaticamente — esta variável
# serve para fixar o domínio canônico quando ele existir.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# --- Área administrativa ------------------------------------------
# A v0 não tem login de usuário (ver docs/idea.md, "Fora da v0"), mas o admin
# de cadastro precisa de ALGUMA proteção. O mecanismo é o da D7 da
# `docs/spec-v0.md`: senha única em variável de ambiente + cookie assinado.
# Sem tabela de usuário e sem PII — descartável inteiro quando a Fase 3
# (embaixadores) trouxer papéis de verdade.

# Senha única de acesso ao /admin. Você escolhe.
ADMIN_PASSWORD="escolha-uma-senha-forte"

# Segredo que assina o cookie de sessão do admin (HMAC). Gere um valor novo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="gere-com-o-comando-acima"


# --- Conteúdo -----------------------------------------------------
# Destino do botão "conhece uma oportunidade assim?" — WhatsApp, e-mail ou
# Telegram do curador. Vai para o browser: use um contato que possa ser público.
NEXT_PUBLIC_CONTATO_INDICACAO="https://wa.me/5500000000000"
